flowchart TD
    A([Boot 启动]) --> B[Intro<br/>显示第 N 天与当前电量]
    B --> C[FindCar<br/>宿舍楼下找车]

    C --> C1{找到自己的车？}
    C1 -- 否 --> C
    C1 -- 是但被夹住 --> C2[挪开相邻车辆<br/>每辆车增加找车时间]
    C2 --> C
    C1 -- 是且已解锁 --> D[Node gate<br/>校门口节点]

    D --> D1{同学请求搭车？}
    D1 -- 接受 --> D2[passenger = true<br/>强制选择校外路线]
    D1 -- 拒绝 --> D3[选择校内 / 校外路线]
    D1 -- 没有同学 --> D3
    D3 --> D4{是否打开背包？}
    D4 -- 是 --> D5[查看钱、饥饿、头盔、牌照]
    D5 --> D3
    D4 -- 否 --> E[Ride 骑行]
    D2 --> E

    E --> E1{选择的路线}
    E1 -- 校内 --> E2[校内路线<br/>路程较远、有坡、无交警]
    E1 -- 校外 --> E3[校外路线<br/>路程较近、车辆更多]

    E2 --> E4[骑行中<br/>W 前进、A/D 换道、S 刹车]
    E3 --> E4

    E4 --> E5{遇到障碍物？}
    E5 -- 否 --> E6{电量耗尽？}
    E5 -- 是 --> E7[扣除 hp<br/>进入短暂无敌]
    E7 --> E8{hp 是否归零？}
    E8 -- 否 --> E4
    E8 -- 是 --> E9[倒地]
    E9 --> E10[连续按 F 扶车<br/>恢复血量、扣除电量]
    E10 --> E6

    E6 -- 是 --> P1[late = true<br/>增加推车时间]
    E6 -- 否 --> E11{是否到达交警检查点？}

    E11 -- 否 --> E12{是否到达教学楼？}
    E11 -- 是且无交警 --> E12
    E11 -- 是且有交警 --> E13[交警检查<br/>头盔、牌照、是否载人]

    E13 --> E14{是否通过检查？}
    E14 -- 是 --> E15[正常通过<br/>载人时到达后获得报酬]
    E14 -- 否 --> E16[罚款并增加耽误时间]
    E16 --> E17{是否载着同学？}
    E17 -- 是 --> E18[同学离开<br/>无法获得报酬]
    E17 -- 否 --> E12
    E15 --> E12
    E18 --> E12

    E12 -- 否 --> E4
    E12 -- 是 --> P2[Park 停车]
    P1 --> P2

    P2 --> P3{推车还是骑车？}
    P3 -- 推车 --> P4[速度减半<br/>显示已迟到]
    P3 -- 骑车 --> P5[正常速度寻找空车位]
    P4 --> P6[寻找空车位并按 F 停车]
    P5 --> P6

    P6 --> P7{停车时间 > 08:00？}
    P7 -- 是 --> P8[late = true]
    P7 -- 否 --> P9[按时到达]
    P8 --> F1[Class morning<br/>上午上课]
    P9 --> F1

    F1 --> F2[减少饥饿度<br/>时间跳到 12:00]
    F2 --> N1[Node noon<br/>中午节点]

    N1 --> N2{中午选择}
    N2 -- 食堂 --> N3[花钱并增加饱腹度]
    N2 -- 后湖 --> N4[耗电并花钱]
    N2 -- 办牌照 --> N5[花钱获得牌照]
    N2 -- 不吃 --> N6[不改变饱腹度]
    N2 -- 背包 --> N7[查看状态或戴摘头盔]
    N7 --> N1

    N4 --> N8{今天有交警？}
    N8 -- 否 --> N3
    N8 -- 是 --> N9[交警检查并可能罚款]
    N9 --> N10{罚款后还有钱吃饭？}
    N10 -- 是 --> N3
    N10 -- 否 --> N6

    N3 --> F3[Class afternoon<br/>下午上课]
    N5 --> F3
    N6 --> F3

    F3 --> F4[减少饥饿度<br/>扣除 dayDrain 电量<br/>时间跳到 17:30]
    F4 --> N11[Node evening<br/>傍晚节点]

    N11 --> N12{傍晚选择}
    N12 -- 食堂 --> N13[花钱并增加饱腹度]
    N12 -- 后湖 --> N14[耗电、花钱并可能遇到交警]
    N12 -- 不吃 --> N15[直接进入夜间流程]
    N12 -- 背包 --> N16[查看状态]
    N16 --> N11
    N13 --> G[Charge 夜间充电]
    N14 --> G
    N15 --> G

    G --> G1{充电桩状态}
    G1 -- 被占用 --> G2[更换充电桩]
    G1 -- 损坏 --> G2
    G1 -- 扫码失败 --> G3[第一次必失败<br/>之后按概率重试]
    G1 -- 空闲 --> G4{钱够支付充电费？}

    G2 --> G
    G3 --> G
    G4 -- 否 --> G5[chargeResult = noMoney]
    G4 -- 是 --> G6[支付充电费并插上充电]

    G6 --> G7{选择充电方式}
    G7 -- 守着充电 --> G8[一直充到 23:00<br/>稳定增加电量]
    G7 -- 回宿舍 --> G9{赌运气}
    G9 -- 成功 --> G10[充满电]
    G9 -- 失败 --> G11[被拔线<br/>只增加少量电量]

    G5 --> G12{23:00 门禁}
    G8 --> R[Result 结算]
    G10 --> R
    G11 --> R
    G12 --> R

    R --> R1{是否迟到？}
    R1 -- 否 --> R2{电量是否达到阈值？}
    R1 -- 是 --> R3{电量是否达到阈值？}

    R2 -- 是 --> R4([准时 + 充上电<br/>难得顺利的一天])
    R2 -- 否 --> R5([准时 + 没充上电<br/>明天早上见分晓])
    R3 -- 是 --> R6([迟到 + 充上电<br/>至少明天有电了])
    R3 -- 否 --> R7([迟到 + 没充上电<br/>明天还得推车])

    R4 --> R8[按 F 开始第二天<br/>保留电量、钱、背包<br/>过夜减少饥饿度]
    R5 --> R8
    R6 --> R8
    R7 --> R8

    R8 --> B

    classDef scene fill:#eaf3ff,stroke:#2f6fce,stroke-width:2px;
    classDef decision fill:#fff7df,stroke:#c78a00,stroke-width:2px;
    classDef action fill:#f6f7f9,stroke:#7b8794,stroke-width:1.5px;
    classDef ending fill:#eaf8ef,stroke:#31945b,stroke-width:2px;

    class A,B,C,D,E,P2,F1,F3,N1,N11,G,R scene;
    class C1,D1,D3,D4,E1,E5,E8,E11,E12,E14,E17,P3,P7,N2,N8,N10,N12,G1,G4,G7,G9,G12,R1,R2,R3 decision;
    class C2,D5,E2,E3,E4,E7,E9,E10,E13,E15,E16,E18,P1,P4,P5,P6,P8,P9,F2,F4,N3,N4,N5,N6,N7,N9,N13,N14,N15,N16,G2,G3,G5,G6,G8,G10,G11,R8 action;
    class R4,R5,R6,R7 ending;